<?xml version='1.0' encoding='utf-8'?>
<odoo>

  <record id="kw_lib_genre_tree" model="ir.ui.view" >
    <field name="name">kw.lib.genre.tree</field>
    <field name="model">kw.lib.genre</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
      </tree>
    </field>
  </record>

  <record id="kw_lib_genre_form" model="ir.ui.view">
    <field name="name">kw.lib.genre.form</field>
    <field name="model">kw.lib.genre</field>
    <field name="arch" type="xml">
      <form string="">
        <header></header>
        <sheet>
          <group>
            <field name="name"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="kw_lib_genre_act_window" model="ir.actions.act_window">
    <field name="name">Genre</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">kw.lib.genre</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="kw_lib_genre_menu"
            action="kw_lib_genre_act_window"
            parent="kw_lib_catalog_menu"
            name="Genre"
            sequence="300"/>

</odoo>